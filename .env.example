# Copy to .env (git-ignored) and fill in. Read by docker compose and by Spring Boot.
HANZI_DB_PASSWORD=change-me

# LLM for vocabulary extraction (spec 01). Default: Anthropic with claude-opus-5-5.
ANTHROPIC_API_KEY=
# Local alternative: HANZI_LLM_PROVIDER=ollama with a vision model, e.g. HANZI_EXTRACTION_MODEL=gemma3:4b
#HANZI_LLM_PROVIDER=ollama
#HANZI_EXTRACTION_MODEL=gemma3:4b
#OLLAMA_BASE_URL=http://localhost:11434
