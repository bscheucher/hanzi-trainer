# Copy to .env (git-ignored) and fill in. Read by docker compose and by Spring Boot.
HANZI_DB_PASSWORD=change-me

# LLM (spec 01). Default: Anthropic, claude-opus-5-5 for vocabulary extraction, claude-sonnet-5-5 for exercises.
ANTHROPIC_API_KEY=
#HANZI_EXERCISE_MODEL=claude-sonnet-5-5
# Local alternative: HANZI_LLM_PROVIDER=ollama with a vision model for extraction and a text model for exercises
#HANZI_LLM_PROVIDER=ollama
#HANZI_EXTRACTION_MODEL=gemma3:4b
#HANZI_EXERCISE_MODEL=qwen3:8b
#OLLAMA_BASE_URL=http://localhost:11434
